# Isolated PostgreSQL + pgvector database used by the backend test suite.
# Copy to `.env.test` and fill in real credentials. `.env.test` is git-ignored;
# never commit a real password here.
#
# The database name must end with `_test` - tests/conftest.py refuses to run
# against anything that looks like an application database.
TEST_DATABASE_URL=postgresql+psycopg2://aegivion_test:CHANGE_ME@localhost:5433/aegivion_test
