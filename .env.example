# Environment Setting
ENVIRONMENT=development # development | test | production

# Backend Configuration
PORT=8000
DATABASE_URL=postgresql://aegivion_user:aegivion_pass@localhost:5432/aegivion_db
REDIS_URL=redis://localhost:6379/0

# Security Configuration
SECRET_KEY=change-this-to-a-secure-random-32-char-string-in-production
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# RSA Key Pair Configuration for JWT RS256
# In production (e.g. Render), paste full PEM content with \n or multiline string.
# In development, if omitted, the app will fall back to local jwt_key.pem or generate one.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

FINDINGS_SCHEMA_VERSION=1.0.0
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/
DEFAULT_ADMIN_PASSWORD=change_this_in_production
NEW_ADMIN_PASSWORD=change_this_to_new_password

# AI Config
LLM_PROVIDER=openai # openai | gemini | azure
OPENAI_API_KEY=your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here
VECTOR_DB_URL=http://localhost:6333 # Qdrant default port

# Frontend Config
VITE_API_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
NEXTAUTH_URL=http://localhost:3000

# AWS Credentials Integration
AWS_ACCESS_KEY_ID=xxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxx
AWS_REGION=ap-south-1
