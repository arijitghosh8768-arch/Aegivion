{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SecurityFinding",
  "type": "object",
  "properties": {
    "finding_id": {
      "type": "string"
    },
    "asset_id": {
      "type": "string"
    },
    "rule_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "info"]
    },
    "risk_score": {
      "type": "number"
    },
    "evidence": {
      "type": "object"
    }
  },
  "required": ["finding_id", "asset_id", "rule_id", "title", "severity", "risk_score", "evidence"]
}
