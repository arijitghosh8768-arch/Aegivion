{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AISecurityAnalysis",
  "type": "object",
  "properties": {
    "finding_id": {
      "type": "string"
    },
    "root_cause": {
      "type": "string"
    },
    "technical_impact": {
      "type": "string"
    },
    "business_impact": {
      "type": "string"
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number"
    }
  },
  "required": ["finding_id", "root_cause", "technical_impact", "business_impact", "recommendations", "confidence"]
}
